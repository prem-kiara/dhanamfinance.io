# ==============================================
# DHANAM FINANCE - Social Media Dashboard
# Environment Configuration
# ==============================================
# Copy this file to .env and fill in your credentials

PORT=5000

# ---- Meta (Facebook, Instagram, Threads) ----
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_long_lived_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_id

# ---- YouTube (Google/YouTube Data API v3) ----
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

# ---- LinkedIn ----
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_ORGANIZATION_ID=your_linkedin_org_id

# ---- Threads (Meta Threads API) ----
THREADS_ACCESS_TOKEN=your_threads_access_token
THREADS_USER_ID=your_threads_user_id

# ---- OpenAI (for AI Content & Image Generation) ----
OPENAI_API_KEY=your_openai_api_key

# ---- Database ----
DB_PATH=./data/dashboard.db

# ---- Upload Directory ----
UPLOAD_DIR=./uploads
