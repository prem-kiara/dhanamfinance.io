{
  "name": "dhanam-social-media-dashboard",
  "version": "1.0.0",
  "description": "Dhanam Finance - Social Media Management Dashboard",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && node index.js",
    "client": "cd client && npx vite --port 3000",
    "build": "cd client && npx vite build",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
